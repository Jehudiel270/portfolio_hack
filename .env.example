# Copier dans .env pour le développement local; ne jamais committer un .env réel.
# Neon PostgreSQL (chaîne pooled TLS; garder sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Générer une nouvelle valeur aléatoire de 48 octets (openssl rand -base64 48).
NUXT_SESSION_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Local development only. On Vercel use "public" for the public project and "admin" for the admin project.
NUXT_APP_ROLE=all
# Cloudinary — seules ces valeurs serveur sont utilisées pour les uploads signés.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# SMTP: port 587 + SMTP_SECURE=false utilise STARTTLS; port 465 + true utilise TLS implicite.
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Portfolio <no-reply@example.com>
CONTACT_FALLBACK_TO=owner@example.com
# Site canonique (facultatif en Preview; l’origine de la requête sert alors de repli).
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Bootstrap initial uniquement avec pnpm admin:create; retirer ADMIN_PASSWORD après l’initialisation.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_ME_WITH_A_NEW_UNIQUE_PASSWORD
# Emergency MFA reset only: set to the exact admin email when running pnpm admin:mfa-reset.
ADMIN_MFA_RESET_EMAIL=
ADMIN_MFA_RESET_CONFIRM=
